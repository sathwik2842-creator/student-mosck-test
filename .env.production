# COMMITTED TEMPLATE ONLY. Keep values blank here.
# Copy to ignored .env.production.local for a local release build, or set these
# names in Vercel Production environment settings / CI before npm run build.
# Firebase Console > Project settings > Your apps > Web app configuration.
# VITE_* values are public browser configuration. Never add Admin private keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: no messaging or Firebase Storage features are currently used.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Keep aligned with both Cloud Functions modules.
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_USE_FIREBASE_EMULATORS=false
