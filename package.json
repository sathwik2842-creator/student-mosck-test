{
  "name": "veda-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-isolation=none functions/test/*.test.js",
    "test:e2e": "playwright test",
    "test:firebase": "firebase emulators:exec --only auth,firestore,functions --project demo-veda-test \"npm run seed:emulator && node tests/firestore.rules.test.mjs && node tests/backend.integration.test.mjs && npm run test:e2e\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-veda-test",
    "seed:emulator": "GCLOUD_PROJECT=demo-veda-test FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed.mjs",
    "seed:production": "node scripts/seed.mjs --production",
    "test:auth": "playwright test tests/auth.spec.js",
    "test:admin-ui": "playwright test tests/admin-ui.spec.js",
    "admin:role": "node scripts/admin-role.mjs",
    "build:emulator": "vite build --mode emulator",
    "check:production": "node scripts/production-env.mjs",
    "release:check": "npm run check:production && npm test && npm run build"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.0",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
